# 复制成 .env 后填写。.env 已被 git 忽略，不要提交真实密钥。

# 必填：模型调用
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：LangGraph 的 checkpoint 与长期记忆（启动时自动建表）
DB_URI=postgresql://root:123456@127.0.0.1:5432/alinAgent

# 可选：代码沙箱。不配则服务照常启动，只是没有代码执行、大文件退化为预览。
# 注意两个变量的前缀顺序相反：
#   客户端（本项目）OPEN_SANDBOX_API_KEY
#   服务端进程      OPENSANDBOX_SERVER_API_KEY，或 ~/.sandbox.toml 的 [server].api_key
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_DOMAIN=localhost:8080
SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.1

# 客户端直连不到沙箱容器 IP 时置 true
SANDBOX_USE_SERVER_PROXY=false

# 创建沙箱等待就绪的上限（秒）。首次拉镜像较慢，默认 180
SANDBOX_READY_TIMEOUT=180
