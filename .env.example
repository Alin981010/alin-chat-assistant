# 复制成 .env 后填写。.env 已被 git 忽略，不要提交真实密钥。

# 必填：模型调用
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：LangGraph 的 checkpoint 与长期记忆（启动时自动建表）
DB_URI=postgresql://root:123456@127.0.0.1:5432/alinAgent

# 助手自称的名字（系统提示词 + 前端文案都用它）
ASSISTANT_NAME=阿林对话助手

# ---------------------------------------------------------------------------
# 代码执行（默认关闭）
#
# 关闭时（默认）：agent 不挂 execute 工具，代码类请求全部走对话——用户把代码
# 贴进来，助手读它、讲它、改它。没有容器、没有"跑任意脚本"的滥用面，
# 也不需要 OpenSandbox 与那十几个 GB 的镜像。
#
# 打开时才恢复：文件落进容器 /workspace、execute 真跑命令、大文件分析走脚本、
# PPT 技能能生成 .pptx 文件。打开前请先想清楚「谁能在这个容器里跑什么」。
# ---------------------------------------------------------------------------
ENABLE_CODE_EXECUTION=false

# ---------------------------------------------------------------------------
# 可选：代码沙箱（仅 ENABLE_CODE_EXECUTION=true 时才会用到）
# 不配则服务照常启动，只是没有代码执行、大文件退化为预览。
# 注意两个变量的前缀顺序相反：
#   客户端（本项目）OPEN_SANDBOX_API_KEY
#   服务端进程      OPENSANDBOX_SERVER_API_KEY，或 ~/.sandbox.toml 的 [server].api_key
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_DOMAIN=localhost:8080
SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.1

# 客户端直连不到沙箱容器 IP 时置 true
SANDBOX_USE_SERVER_PROXY=false

# 创建沙箱等待就绪的上限（秒）。首次拉镜像较慢，默认 180
SANDBOX_READY_TIMEOUT=180

# ---------------------------------------------------------------------------
# 匿名身份与访问控制（对外部署时务必看这一节）
#
# 本应用没有登录，但每个浏览器会拿到一个**服务端签名**的匿名身份，签名里的
# org_id 决定它用哪个沙箱容器。签名保证访客不能自己编造 org_id 去访问别人的
# 工作区，代价是零用户表、零登录页。
# ---------------------------------------------------------------------------

# 签名密钥。不配也能启动（会由 DB_URI 派生并打 warning），但：
#   - 多实例部署必须显式配置，且各实例保持一致；
#   - 改数据库口令会让派生的密钥变化，所有访客身份失效（文件还在，但会换容器）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# CORS 白名单，逗号分隔。留空 = 允许所有来源（内网/单机默认行为）。
# 对外提供服务时应填真实站点，例如 https://alin.example.com
APP_ALLOWED_ORIGINS=

# 身份 cookie 是否只在 HTTPS 下发送。对外用 HTTPS 时置 true。
APP_COOKIE_SECURE=false

# 每个 org 每分钟最多执行多少次沙箱命令（默认 60）。
# 单次执行时长另有硬上限 300 秒，不受请求方影响。
# 沙箱容器本身建议再限制 CPU/内存（OpenSandbox 侧的容器配额）。
EXECUTE_RPM_PER_ORG=60
EXECUTE_TIMEOUT_MAX=300

# ---------------------------------------------------------------------------
# 额度与限流（token 是被「反复对话」烧掉的，这几项才是在保额度）
#
# 分**游客**与**注册用户**两档。游客没有身份成本（清 cookie 就能换一个），
# 所以额度刻意压到"够体验、不够白嫖"；注册用户用下面那组默认值。
#
# 所有项填 0 表示「不限」。默认值偏保守，按最坏情况估算后再放宽。
# ---------------------------------------------------------------------------

# ---- 注册用户（登录之后）----

# 每个浏览器身份每分钟的对话次数。默认 8。
CHAT_RPM_PER_USER=8

# 每个 IP 每分钟的对话次数。默认 30。
# 为什么还要按 IP：身份存在 cookie 里，访客清掉 cookie 就能拿到新身份、
# 额度随即重置。按 IP 这一层是兜底。
CHAT_RPM_PER_IP=30

# 每个身份每天可消耗的 token 总量。默认 200 万。
# 这是**唯一能封顶账单**的项：到量后对话直接 429，流式生成中途也会被截断。
# 200 万 token 大致相当于一两百次中等长度对话（历史越长单次越贵）。
CHAT_DAILY_TOKEN_BUDGET=2000000

# 单条消息的输入上限（估算 token）。挡住「粘贴一本书」。默认 6 万。
CHAT_MAX_INPUT_TOKENS=60000

# ---- 游客（未登录）----

# 游客每天的 token 总量。默认 2 万，约 3–5 轮对话，到量后提示注册。
GUEST_DAILY_TOKEN_BUDGET=20000

# 游客每分钟的对话次数。默认 3。
GUEST_RPM_PER_USER=3

# 游客单条消息的输入上限。默认 200 tokens（约 400 汉字）——
# 够问清楚问题，不够把整篇文章丢进来当免费摘要机。
GUEST_MAX_INPUT_TOKENS=200

# **每个 IP 每天的游客 token 总量**（默认 6 万）。
# 这一层才是真正的兜底：游客清 cookie 换身份绕得过"按身份"的额度，
# 绕不过"按 IP"的。设得太大就等于没设。
GUEST_DAILY_TOKEN_BUDGET_PER_IP=60000

# ---------------------------------------------------------------------------
# 账号
# ---------------------------------------------------------------------------

USERNAME_MIN_LEN=3
USERNAME_MAX_LEN=32
PASSWORD_MIN_LEN=8

# PBKDF2 迭代次数。60 万是 OWASP 对 PBKDF2-HMAC-SHA256 的现行建议量级，
# 单次校验约几十毫秒。调低会削弱"库被拖走后离线爆破"的防护，不建议。
PBKDF2_ITERATIONS=600000

# 登录会话有效期（秒）。默认 30 天。
SESSION_TTL_SECONDS=2592000

# 模型单次回复的输出上限（max_tokens）。默认 4096。
# 上限越高，一次请求被刷走的钱越多。
AGENT_MAX_OUTPUT_TOKENS=4096

# agent 单次提问允许的图步数（一步 ≈ 一次模型调用）。
# DeepAgents 默认 9999，等于不设限——工具一旦打转，一次提问能烧几百次调用。
# 一轮正常问答在 10 步以内，40 已经算宽松。默认 40。
AGENT_RECURSION_LIMIT=40

